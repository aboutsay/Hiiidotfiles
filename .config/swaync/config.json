{
  "$schema": "/etc/swaync/config.schema.json",
  "positionX": "center",
  "positionY": "top",
  "control-center-width": 380,
  "notification-window-width": 300,
  "layer": "top",
  "cssPriority": "application",
  "widgets": [
    "title",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "BLOOD IS FUEL !!!",
      "clear-all-button": true,
      "button-text": "clear"
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾"
    },
    "backlight": {
      "label": "󰃠",
      "device": "intel_backlight"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩",
          "command": "pkill rofi || networkmanager_dmenu"
        },
        {
          "label": "󰂯",
          "command": "pkill blueman-manager || blueman-manager"
        },
        {
          "label": "B",
          "command": "~/.config/hypr/blur/blur.sh"
        },
        {
          "label": "?",
          "command": "hyprctl dispatch exec '[float; size 1200 600; center] kitty --class nano -e nano ~/info.md'"
        },
        {
          "label": "󰄀",
          "command": "hyprpicker -a"
        },
        {
          "label": "󰐥",
          "command": "wlogout"
        }
      ]
    }
  }
}
