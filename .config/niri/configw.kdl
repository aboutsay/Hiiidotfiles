// ######################################################################################
// config.kdl — niri version of hyprland.lua
// Niri uses KDL (https://kdl.dev), NOT Lua. This is a from-scratch translation,
// kept as close as possible to the original Hyprland behavior.
// This file lives at ~/.config/niri/config.kdl and is completely separate from
// ~/.config/hypr/hyprland.lua — installing this does NOT touch or break your
// existing Hyprland setup in any way. You can keep both installed and pick
// whichever session you log into.
//
// Docs used: https://github.com/niri-wm/niri/wiki/Configuration:-Introduction
// Run `niri validate` after editing to catch syntax errors.
// ######################################################################################

// ------------------------------------------------------------------
// PROGRAMS (niri has no $terminal/$fileManager/$menu variables like
// hyprlang did — KDL has no variable substitution, so these are just
// written directly into each bind below).
// terminal    = kitty
// fileManager = nemo
// menu        = rofi
// ------------------------------------------------------------------

// ------------------------------------------------------------------
// INPUT
// ------------------------------------------------------------------
input {
    keyboard {
        xkb {
            layout ""
            model ""
            variant ""
            options ""
        }
    }

    touchpad {
        // FIX: the touchpad block was basically empty (no "tap" node),
        // and libinput's default click-method is "button-areas" — on a
        // clickpad like the ProBook's (one big physical button, no
        // separate left/right buttons) that means right-click only
        // registers if you press in the exact bottom-right corner, which
        // is finicky and easy to miss, and can feel like left-click is
        // unreliable too since the whole pad has to physically depress.
        //
        // tap            -> tapping the pad registers as a click (1-finger
        //                    tap = left click, 2-finger tap = right click,
        //                    3-finger tap = middle click by default).
        // click-method    -> "clickfinger" uses the NUMBER OF FINGERS
        //                    touching when you physically press the pad
        //                    to decide left/right/middle, instead of
        //                    WHERE on the pad you press. Much more
        //                    reliable on a single-button clickpad.
        // dwt             -> disable-while-typing, ignores the touchpad
        //                    for a moment after a keypress so your palm
        //                    doesn't trigger clicks while typing.
        tap
        click-method "clickfinger"
        dwt

        // natural_scroll = false in your hyprland.lua. Leaving this
        // commented out is correct as-is: niri/libinput default
        // natural-scroll to OFF when the node is absent, not on (the
        // previous comment here had that backwards, but the actual
        // setting was already right).
        // natural-scroll
    }

    mouse {
        // sensitivity 0 in hyprland.lua == default, nothing to set here.
    }

    // FIX: the node was "follow-mouse-max-scroll-amount \"0%\"" which is not a real
    // niri option (invalid node name + string argument where a named property is
    // expected). The real node is "focus-follows-mouse", and it takes a
    // max-scroll-amount= property, not a bare string.
    focus-follows-mouse max-scroll-amount="0%" // roughly mirrors follow_mouse = 1 (loose)
}

// ------------------------------------------------------------------
// CURSOR
// ------------------------------------------------------------------
cursor {
    xcursor-size 24
}

// ------------------------------------------------------------------
// ENVIRONMENT (replaces hl.env(...))
// ------------------------------------------------------------------
environment {
    XCURSOR_SIZE "24"
    HYPRCURSOR_SIZE "24" // harmless leftover, only meaningful under Hyprland
}

// ------------------------------------------------------------------
// OUTPUTS (replaces hl.monitor)
// niri has no wildcard "*" output like Hyprland — each output must be
// named. Run `niri msg outputs` once inside a niri session to get your
// real output name, then replace "eDP-1" below if it's different.
// ------------------------------------------------------------------
output "eDP-1" {
    mode "1366x768@60"
    position x=0 y=0
    scale 1.0
}

// ------------------------------------------------------------------
// OVERVIEW (the zoomed-out view of all workspaces, Mod+O by default —
// this controls the "backdrop" color/shadow you see BEHIND the
// workspace cards when the overview is open).
// ------------------------------------------------------------------
overview {
    zoom 0.5
    // Fallback color if the wallpaper layer below isn't picked up for
    // some reason — the actual wallpaper-in-backdrop setup is the
    // layer-rule + layout background-color right after this block.
    backdrop-color "#1a1a1a"

    workspace-shadow {
        softness 40
        spread 10
        offset x=0 y=10
        color "#00000050"
    }
}

// Put your wallpaper tool's layer-shell surface INTO the overview
// backdrop, so instead of a flat color you see the (zoomed-out)
// wallpaper behind the workspaces.
// You're running awww/swww — the namespace is usually "wallpaper", but
// run `niri msg layers` while it's running to confirm the exact name,
// then fix the match below if it's different.
layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}
// Note: "background-color \"transparent\"" was added inside the existing
// layout{} block further below (niri only reads ONE top-level layout{}
// block — having two would silently break things), so that's where you'll
// find it, not here.

// ------------------------------------------------------------------
// AUTOSTART (replaces hl.on("hyprland.start", ...) / exec-once)
// ------------------------------------------------------------------
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "hypridle"
spawn-at-startup "wlsunset" "-t" "3499" "-T" "3500"

// Shell one-liners (pipes, sleep, loops) need spawn-sh-at-startup.
spawn-sh-at-startup "sleep 1 && swww img ~/Pictures/wallpapers/zero.png"
spawn-sh-at-startup "while true; do ~/.config/hypr/scripts/battery-warn.sh; sleep 60; done"
spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"

// ------------------------------------------------------------------
// PERMISSIONS
// niri has no equivalent of hl.config({ ecosystem = { enforce_permissions } })
// or hl.permission(...) — it doesn't have a screencopy/plugin permission
// system in the config. Nothing to port here.
// ------------------------------------------------------------------

// ------------------------------------------------------------------
// LOOK AND FEEL (replaces general{} / decoration{})
// ------------------------------------------------------------------
layout {
    // Makes the per-workspace fill transparent, so the wallpaper placed
    // in the overview backdrop (see the layer-rule near the top of this
    // file) shows through instead of a flat color.
    background-color "transparent"

    // Hyprland had gaps_in=5 / gaps_out=9 separately; niri only has one
    // "gaps" value (space around every window), so this splits the
    // difference.
    gaps 8

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Mirrors general.col.active_border / inactive_border.
    // Niri doesn't support a two-color gradient + angle like Hyprland's
    // "rgba(...) rgba(...) 45deg", but it does support gradients — kept
    // simple here as solid colors; uncomment the gradient line if you want
    // the closer visual match.
    focus-ring {
        width 2
        active-color "#d18a06"
        inactive-color "#595959"
        // active-gradient from="#d18a06" to="#ffffff" angle=45
    }

    // You had no persistent border in Hyprland (just the animated
    // active_border), so the niri "border" (always-visible) stays off.
    border {
        off
    }

    shadow {
        // decoration.shadow.enabled was false -> stays off (this is the
        // default anyway when "on" isn't present, kept for clarity)
        off
    }

    struts {
        // no equivalent set in your hyprland.lua
    }
}

// rounding = 10, rounding_power = 2, active_opacity = 0.93,
// inactive_opacity = 0.80 and blur{} have NO global equivalent in niri's
// layout{} block. Rounding + opacity are done per-window via window-rule
// (see below); niri has no compositor-side blur at all as of now.

// prefer-no-csd  // uncomment if you want niri to ask clients to drop
                  // client-side decorations, similar in spirit to Hyprland
                  // always drawing its own borders/rounding.

// ------------------------------------------------------------------
// ANIMATIONS
// Niri's animation model is different (easing OR spring per-animation,
// not bezier curves), so speeds/curves are approximated, not a 1:1 port.
// ------------------------------------------------------------------
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 140
        curve "ease-out-expo"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

// ------------------------------------------------------------------
// GESTURES
// hl.gesture 3-finger horizontal swipe -> workspace switch is niri's
// built-in touchpad default behavior already, nothing to add.
// hl.device sensitivity for "epic-mouse-v1" has no direct per-device
// pointer config section in niri beyond input{ mouse{} }/trackpoint{}.
// ------------------------------------------------------------------

// ------------------------------------------------------------------
// WINDOW RULES (replaces hl.window_rule)
// niri matches on app-id (Wayland) instead of Hyprland's X11-style
// "class" — app-id strings below are best-effort guesses; check the
// real value with `niri msg windows` if a rule doesn't catch a window.
// ------------------------------------------------------------------

// Rounded corners globally, mirrors decoration.rounding = 10
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Approximate opacity (niri has one "opacity" value, not separate
// active/inactive like Hyprland's active_opacity/inactive_opacity).
window-rule {
    opacity 0.93
}

// FIX: kitty was showing up as a solid orange block when focused.
// By default niri draws focus-ring/border as a solid background rectangle
// BEHIND the window, which shows through any semi-transparent window (like
// kitty with a lowered background_opacity in kitty.conf). This rule tells
// niri to draw the ring as an outline around kitty instead of a filled
// rectangle behind it.
window-rule {
    match app-id="^(kitty)$"
    draw-border-with-background false
}

window-rule {
    match app-id="^(waypaper)$"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

// FIX: app-id="^(org\.gnome\.Loupe)$" used a plain quoted string with a
// literal "\." inside it. In KDL, \x is only valid for a small fixed set
// of escapes (\n \t \\ \" ...); "\." is NOT one of them, so the parser
// rejects the whole file. Regex patterns with backslashes must use a raw
// string r#"..."# so the backslash is passed through untouched.
window-rule {
    match app-id=r#"^(org\.gnome\.Loupe)$"#
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="^(nm-connection-editor)$"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 500; }
}

window-rule {
    match app-id="^(blueman-manager)$"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="^(mpv)$"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

// FIX: same raw-string issue as above (org\.gnome\.Showtime).
window-rule {
    match app-id=r#"^(org\.gnome\.Showtime)$"#
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="^(xdg-desktop-portal-gtk)$"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 700; }
}

window-rule {
    match app-id="^(Spotify|spotify)$"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 700; }
}

window-rule {
    match app-id="^(code-oss|code|codium)$"
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 700; }
}

// FIX: same raw-string issue as above (org\.telegram\.desktop).
window-rule {
    match app-id=r#"^(org\.telegram\.desktop)$"#
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 700; }
}

window-rule {
    match app-id="^(steam)$"
    open-floating true
}

window-rule {
    match app-id="^(nemo)$"
    open-floating true
}

// hl.window_rule "suppress-maximize-events" and "fix-xwayland-drags" have
// no niri equivalent (niri has no maximize-event suppression setting and
// handles Xwayland drags itself via xwayland-satellite).
// hl.window_rule "move-hyprland-run" was Hyprland-launcher-specific,
// nothing to port.

// ------------------------------------------------------------------
// KEYBINDINGS (replaces hl.bind / hl.gesture)
// "Mod" = Super in a real niri session, Alt when nested in a window —
// same idea as $mainMod in the original.
// ------------------------------------------------------------------
binds {
    Mod+T { spawn "kitty"; }
    Mod+Q { close-window; }
    Mod+M { spawn-sh "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || niri msg action quit"; }
    Mod+E { spawn "nemo"; }
    Mod+V { toggle-window-floating; }
    Mod+P { spawn-sh "echo 'pseudo-tiling has no niri equivalent (no pseudotile mode)'"; }
    Mod+J { toggle-column-tabbed-display; } // closest niri has to "togglesplit"

    // Move focus
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // Workspaces 1-9, 0 -> 10
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Scratchpad: niri has no special:magic scratchpad workspace.
    // Closest equivalent is toggling a window floating + a named
    // workspace you park it on.
    // Mod+S / Mod+Shift+S -> no direct mapping, left unbound.

    // Scroll through workspaces
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Move / resize windows with mouse (niri does this by default with
    // Mod+Left-click drag and Mod+Right-click resize — no bind needed).

    // Media / brightness keys
    XF86AudioRaiseVolume allow-when-locked=true repeat=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true repeat=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute        allow-when-locked=true repeat=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true repeat=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true repeat=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true repeat=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }

    // playerctl
    XF86AudioNext  allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPlay  allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev  allow-when-locked=true { spawn-sh "playerctl previous"; }

    // ------------------------------------------------------------
    // CUSTOM BINDS
    // ------------------------------------------------------------

    // Rofi launcher. Hyprland bound this to *releasing* the bare Super
    // key (mainMod+SUPER_L, release=true). Niri's binds are combos of
    // modifiers + a key, so a bare-Super-release launcher isn't directly
    // portable — Mod+D is the standard niri convention for a launcher.
    Mod+D { spawn-sh "pkill rofi || rofi -show drun -theme gruvbox-dark"; }

    Mod+F { spawn "firefox"; }
    Mod+W { spawn-sh "~/.config/hypr/wall.sh"; }
    Mod+L { spawn-sh "pkill rofi || ~/.config/hypr/scripts/LIVE_wallpaper-picker.sh"; }
    Mod+O { spawn-sh "pkill mpvpaper"; } // note: this overrides niri's default Mod+O (toggle-overview)

    Print { spawn-sh "~/.config/hypr/scripts/screenshot.sh"; }

    Mod+N { spawn-sh "swaync-client -t -sw"; }

    // Toggling waypaper by checking if it's already running: niri's
    // static KDL config has no window-query API like hl.get_windows(),
    // so this is approximated with pkill-or-spawn instead of a true
    // toggle.
    Mod+R { spawn-sh "pkill waypaper || waypaper"; }

    Mod+G { fullscreen-window; }
}
